+	write_seqlock(&susfs_uname_seqlock);
+	if (!strcmp(info.release, "default")) {
+		strscpy(my_uname.release, utsname()->release, __NEW_UTS_LEN);
+	} else {
+		strncpy(my_uname.release, info.release, __NEW_UTS_LEN);
