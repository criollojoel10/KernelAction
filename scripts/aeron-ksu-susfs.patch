+		inode && inode->i_mapping && \
+		unlikely(test_bit(AS_FLAGS_OPEN_REDIRECT, &inode->i_mapping->flags)) && \
+		susfs_is_current_proc_umounted_app()
+#endif // #ifndef KSU_SUSFS_DEF_H
